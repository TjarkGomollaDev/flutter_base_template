{
  "template-conventions": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "sh tool/run_compiled.sh agent_hook antigravity pre-tool"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|multi_edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh tool/run_compiled.sh agent_hook antigravity post-tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh tool/run_compiled.sh agent_hook antigravity stop"
          }
        ]
      }
    ]
  }
}
